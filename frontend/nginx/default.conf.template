# Rendered by the nginx image's envsubst step. Every variable has a default in the Dockerfile:
#   API_UPSTREAM, NGINX_RESOLVER   where the API is, and the resolver that finds it
#   NGINX_HSTS                     Strict-Transport-Security value; empty (no header) unless the
#                                  site is served over HTTPS (production and its rehearsal)
#   NGINX_MAX_BODY                 largest request body (the API enforces MAX_REQUEST_BYTES too)
#   NGINX_READ_TIMEOUT             how long a quiet upstream may stay silent; the API sends a
#                                  heartbeat every 15 s, so a stream that stops fails here first
#   NGINX_DESIGN                   "on" serves /design (development); "off" is a 404
# Also here (ADR-0045): the static site is gzipped (the bundle budget is measured gzipped), and
# the link-preview tags in index.html get this site's own address, because the domain is not known
# when the image is built.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size ${NGINX_MAX_BODY};

    # Compression is for the static site only: `gzip on` appears in the static locations below and
    # never in the API's. API responses carry one person's data and a stream (BREACH, and a stream
    # must not be held back to be compressed). Fonts and images are already compressed.
    gzip_types text/css text/javascript application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
    gzip_comp_level 6;
    gzip_vary on;

    # index.html names this site's address in its link-preview tags as __SITE_ORIGIN__ (see the
    # map at the end). Only text/html is rewritten; JSON, streams and assets pass untouched.
    sub_filter_once off;
    sub_filter '__SITE_ORIGIN__' '$site_origin';

    # Re-resolve the API's address every 2 s: a recreated api container gets a new IP, and nginx
    # would otherwise keep proxying to the old one. Short, so a restarted api is found well inside
    # the 15 s the edge holds requests for during a deploy.
    resolver ${NGINX_RESOLVER} valid=2s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    # Same origin only: the SPA's own scripts, styles and bundled fonts, and /v1 on this host.
    # Inline style attributes are allowed (the motion library animates through them); inline
    # scripts are not.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "${NGINX_HSTS}" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The API, and its readiness (the edge's health check and the deploy's wait use /readyz).
    # Buffering off so server-sent events stream token by token; the API sends a heartbeat
    # comment every SSE_HEARTBEAT_S, well inside the read timeout.
    location ~ ^/(v1/|readyz$) {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        # The browser's own host:port, so the API's same-origin check sees what the page saw.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        # The API sends its own security headers (CSP default-src 'none', no-store, nosniff...);
        # a location's add_header replaces the server's, so only HSTS is added here, once.
        proxy_hide_header Strict-Transport-Security;
        add_header Strict-Transport-Security "${NGINX_HSTS}" always;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout ${NGINX_READ_TIMEOUT};
    }

    # No add_header below this point: a location with its own add_header drops every header
    # set above, so caching is set with `expires` and each response keeps the security headers.
    location = /design {
        if ($design_off) {
            return 404;
        }
        gzip on;
        expires -1;
        try_files /index.html =404;
    }

    location /assets/ {
        gzip on;
        expires 1y;
        try_files $uri =404;
    }

    location / {
        gzip on;
        expires -1;
        try_files $uri /index.html;
    }
}

map "${NGINX_DESIGN}" $design_off {
    "on" 0;
    default 1;
}

# This site's address as the visitor used it, for the link-preview tags. Behind the edge (Caddy)
# the scheme arrives in X-Forwarded-Proto; with no proxy it is nginx's own. Both parts are checked
# against a strict pattern, so a crafted Host or X-Forwarded-Proto can never put markup into the
# page: anything else gives an empty origin and the tags fall back to relative paths.
map "$http_x_forwarded_proto|$http_host" $site_origin {
    default "";
    "~^(https?)\|([A-Za-z0-9.-]+(?::[0-9]{1,5})?)$" "$1://$2";
    "~^\|([A-Za-z0-9.-]+(?::[0-9]{1,5})?)$" "$scheme://$1";
}
