# Rendered by the nginx image's envsubst step. Every variable has a default in the Dockerfile:
#   API_UPSTREAM, NGINX_RESOLVER   where the API is, and the resolver that finds it
#   NGINX_HSTS                     Strict-Transport-Security value; empty (no header) unless the
#                                  site is served over HTTPS (production and its rehearsal)
#   NGINX_MAX_BODY                 largest request body (the API enforces MAX_REQUEST_BYTES too)
#   NGINX_READ_TIMEOUT             how long a quiet upstream may stay silent; the API sends a
#                                  heartbeat every 15 s, so a stream that stops fails here first
#   NGINX_DESIGN                   "on" serves /design (development); "off" is a 404
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size ${NGINX_MAX_BODY};

    # Re-resolve the API's address every 2 s: a recreated api container gets a new IP, and nginx
    # would otherwise keep proxying to the old one. Short, so a restarted api is found well inside
    # the 15 s the edge holds requests for during a deploy.
    resolver ${NGINX_RESOLVER} valid=2s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    # Same origin only: the SPA's own scripts, styles and bundled fonts, and /v1 on this host.
    # Inline style attributes are allowed (the motion library animates through them); inline
    # scripts are not.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "${NGINX_HSTS}" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The API, and its readiness (the edge's health check and the deploy's wait use /readyz).
    # Buffering off so server-sent events stream token by token; the API sends a heartbeat
    # comment every SSE_HEARTBEAT_S, well inside the read timeout.
    location ~ ^/(v1/|readyz$) {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        # The browser's own host:port, so the API's same-origin check sees what the page saw.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        # The API sends its own security headers (CSP default-src 'none', no-store, nosniff...);
        # a location's add_header replaces the server's, so only HSTS is added here, once.
        proxy_hide_header Strict-Transport-Security;
        add_header Strict-Transport-Security "${NGINX_HSTS}" always;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout ${NGINX_READ_TIMEOUT};
    }

    # No add_header below this point: a location with its own add_header drops every header
    # set above, so caching is set with `expires` and each response keeps the security headers.
    location = /design {
        if ($design_off) {
            return 404;
        }
        expires -1;
        try_files /index.html =404;
    }

    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    location / {
        expires -1;
        try_files $uri /index.html;
    }
}

map "${NGINX_DESIGN}" $design_off {
    "on" 0;
    default 1;
}
