# The shape of .env.prod, the gitignored file `make prod-secrets` writes to SSM Parameter Store
# under /secondmind/prod/ (guide step 10). Copy it to .env.prod and fill it in. The deploy reads
# every parameter under that path into the host's env file, and docs/deploy/config.md says what
# each one is; a test keeps this file and that matrix in step.
#
# Values are single-quoted by the host, so they must not contain a quote or a newline.
# Nothing here is a real value: never commit .env.prod.

# [secret] stored as SecureString (encrypted with the account's default key)
# Production keys, new ones made for this site (guide step 6), with a spend limit set at each
# provider as a second guard.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Langfuse Cloud project secret key (guide step 6).
LANGFUSE_SECRET_KEY=
# Signs the session cookie: `openssl rand -hex 32`.
SESSION_SECRET=
# The access code every way in asks for until S5 opens the site: `openssl rand -hex 6`.
ACCESS_CODE=
# The database owner, the app's database role and Redis: `openssl rand -hex 24` each.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=

# [plain] stored as String
# The site's host name, 2nd-mind.<domain>, and its origin (the same, with https://).
APP_HOST=
ALLOWED_ORIGINS=
# The images: ghcr.io/<your GitHub user or organisation, lower case>
IMAGE_REGISTRY=
# Tracing to Langfuse Cloud, metadata only. TRACING_ENABLED=false until the project exists.
TRACING_ENABLED=true
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_PROJECT_ID=
LANGFUSE_UI_URL=https://us.cloud.langfuse.com
# What the app may spend at each provider since the date it was topped up (decision 7): below the
# real balance, so the app stops before the provider does.
PROVIDER_CREDIT_USD_ANTHROPIC=2
PROVIDER_CREDIT_USD_OPENAI=1
PROVIDER_CREDIT_SINCE=
# App-wide spend caps, in dollars.
SPEND_CAP_DAILY_USD=0.50
SPEND_CAP_MONTHLY_USD=5
# Stays false until S5 opens the site to guests.
GUESTS_OPEN=false
